# Copy to .env and adjust. .env is git-ignored — never commit secrets.
# The worker shares Postgres + RabbitMQ with eventa-api (start them from that repo's
# docker-compose, and run eventa-api's migrations first — the api owns the schema).

NODE_ENV=development
PORT=3100                 # health probe HTTP surface

# Datastores (match eventa-api's docker-compose.yml)
DATABASE_URL=postgres://eventa:eventa@localhost:5432/eventa
RABBITMQ_URL=amqp://eventa:eventa@localhost:5672
REDIS_URL=redis://localhost:6379

# Observability
LOG_LEVEL=debug

# RabbitMQ topology
RABBITMQ_EXCHANGE=eventa.events
RABBITMQ_QUEUE=eventa.worker
RABBITMQ_PREFETCH=10

# Idempotency (dedupe window, seconds)
IDEMPOTENCY_TTL_SECONDS=86400

# Closing the orders nobody paid for (US-DISC-05). The sweep runs every minute;
# the grace is the window a payment webhook still in flight needs to land after
# a seat hold lapses.
ORDER_EXPIRY_GRACE_MS=120000
ORDER_EXPIRY_BATCH=200

# Email delivery
# `log` records that a message was sent and drops it — no credentials, and no
# way to mail a real attendee from a dev box. `smtp` sends for real; with the
# docker-compose Mailpit running, everything lands at http://localhost:8025.
# Production refuses `log`: it would be a silent outage, not a safe default.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Eventa <no-reply@eventa.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit needs no credentials; a real provider does.
# SMTP_USER=
# SMTP_PASSWORD=

# Where the attendee-facing site lives, for links written into email (the
# event reminder's ticket link, the post-event thank-you's survey link). Same
# name as eventa-api. Unset, both jobs stay off and log why; nothing else
# needs it.
PUBLIC_WEB_URL=http://localhost:5173
